@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard - MeenA7rf Quiz</title>

    <!-- Modern Font Import -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            min-height: 100vh;
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1508264165352-2585356e95d0?auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover;
            color: #ffffff;
            overflow-x: hidden;
        }

        /* Sidebar */
        .sidebar {
            background: linear-gradient(180deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.95));
            width: 250px;
            flex-shrink: 0;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            border-right: 2px solid #4A90E2;
            transition: width 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
        }

            .sidebar.collapsed {
                width: 70px;
                padding: 30px 10px;
                align-items: center;
            }

            .sidebar h2 {
                text-align: center;
                color: #4A90E2;
                font-weight: 700;
                font-size: 1.8rem;
                margin-bottom: 20px;
                letter-spacing: -0.5px;
                transition: opacity 0.3s ease, transform 0.3s ease;
            }

            .sidebar.collapsed h2 {
                opacity: 0;
                transform: scale(0);
            }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #e2e8f0;
            font-size: 1rem;
            font-weight: 500;
            cursor: pointer;
            padding: 12px 16px;
            border-radius: 10px;
            transition: all 0.3s ease;
            text-decoration: none;
            white-space: nowrap;
            position: relative;
            overflow: hidden;
        }

            .menu-item::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
                transition: left 0.5s;
            }

            .menu-item:hover::before {
                left: 100%;
            }

            .menu-item svg {
                width: 20px;
                height: 20px;
                fill: #94A3B8;
                flex-shrink: 0;
                transition: fill 0.3s ease;
            }

            .menu-item:hover {
                background: rgba(74, 144, 226, 0.2);
                color: #ffffff;
                transform: translateX(4px);
                box-shadow: 0 4px 12px rgba(74, 144, 226, 0.3);
            }

                .menu-item:hover svg {
                    fill: #4A90E2;
                }

        .sidebar.collapsed .menu-item {
            justify-content: center;
            gap: 0;
        }

            .sidebar.collapsed .menu-item span {
                display: none;
            }

        /* Toggle button */
        .toggle-btn {
            position: absolute;
            top: 20px;
            left: 260px;
            font-size: 1.4rem;
            background: linear-gradient(135deg, #4A90E2, #357ABD);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            padding: 8px 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(74, 144, 226, 0.3);
        }

            .toggle-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 12px rgba(74, 144, 226, 0.4);
            }

        .sidebar.collapsed + .toggle-btn {
            left: 80px;
        }

        /* Main content */
        .main-content {
            flex: 1;
            padding: 40px;
            overflow-y: auto;
            transition: margin-left 0.3s ease;
            margin-left: 0;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 0 20px 20px 0;
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #4A90E2, #357ABD);
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(135deg, #357ABD, #2C5AA0);
            }

        /* Responsive */
        @@media (max-width: 768px) {
            body

        {
            flex-direction: column;
        }

        .sidebar {
            width: 100%;
            height: auto;
            flex-direction: row;
            justify-content: center;
            padding: 15px 0;
            border-right: none;
            border-bottom: 2px solid #4A90E2;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

            .sidebar.collapsed {
                height: 70px;
                width: 100%;
            }

        .toggle-btn {
            left: 20px;
            top: 80px;
        }

        .main-content {
            padding: 20px;
            border-radius: 0;
        }

        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <h2>Admin Panel</h2>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="menu-item">📊 DashBoard</a>
        <a asp-area="Admin" asp-controller="User" asp-action="Admin" class="menu-item">
            <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                </svg>
                <span>Admins</span>
            </a> <a asp-area="Admin" asp-controller="User" asp-action="Player" class="menu-item">
                <svg viewBox="0 0 24 24">
                    <path d="M3 13h2v-2H3v2zm0 6h2v-2H3v2zm0-12h2V5H3v2zm4 12h12v-2H7v2zm0-4h12v-2H7v2zm0-6v2h12V7H7z" />
                    </svg>
                    <span>Players</span>
            </a>
                <a href="/Questions" class="menu-item">
                    <svg viewBox="0 0 24 24">
                    <path d="M12 4a4 4 0 0 0-4 4v1c0 1.1.9 2 2 2h3v2h-2v2h2v2h-3v2h3v1h-3v1h6v-2H14v-1h6v-2h-2v-1h2v-2h-2v-1h2v-2h-2v-1a4 4 0 0 0-4-4z" />
                    </svg>
                    <span>Questions</span>
                </a> 
                <a href="/Answers" class="menu-item">
                    <svg viewBox="0 0 24 24"><path d="M20 6h-3v12h3v-2h-1v-1h1v-1h-1v-1h1V8h-1V7h1V6zM4 18h7v-2H6v-2h5v-2H6v-2h5V6H4v12z" />
                    </svg>
                    <span>Answers</span> 
                </a> 
    </aside>

    <!-- Toggle Button -->
    <button class="toggle-btn" id="toggleBtn">☰</button>

    <!-- Main Content -->
    <div id="main-content" class="main-content">
        @RenderBody()
    </div>

    <script>
        // Sidebar toggle
        const sidebar = document.getElementById("sidebar");
        const toggleBtn = document.getElementById("toggleBtn");

        toggleBtn.addEventListener("click", () => {
            sidebar.classList.toggle("collapsed");
        });
    </script>

    <!-- ⚽ Custom Football Toaster -->
    <div id="custom-toaster"></div>

    <style>
        /* 🏟️ Container */
        #custom-toaster {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 4000;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* 💫 Toast Message */
        .toast-msg {
            min-width: 310px;
            padding: 15px 18px;
            border-radius: 14px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
            position: relative;
            overflow: hidden;
            animation: toastSlideIn 0.6s ease, fadeOut 0.6s ease 4.5s forwards;
            font-family: "Inter", sans-serif;
            font-weight: 500;
            letter-spacing: 0.3px;
            backdrop-filter: blur(10px);
        }

            /* 🟢 Success */
            .toast-msg.success {
                background: linear-gradient(135deg, #10B981, #059669);
                border-left: 6px solid rgba(255, 255, 255, 0.3);
            }

            /* 🔴 Error */
            .toast-msg.error {
                background: linear-gradient(135deg, #EF4444, #DC2626);
                border-left: 6px solid rgba(255, 255, 255, 0.3);
            }

        /* ⚽ Icon Section */
        .toast-content {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-grow: 1;
        }

        .toast-icon {
            font-size: 1.8rem;
            animation: bounceIcon 1.2s infinite ease-in-out;
        }

        /* ❌ Close Button */
        .toast-close {
            cursor: pointer;
            font-weight: bold;
            font-size: 1.2rem;
            opacity: 0.8;
            transition: all 0.3s ease;
        }

            .toast-close:hover {
                opacity: 1;
                transform: scale(1.15) rotate(90deg);
            }

        /* ✨ Animations */
        @@keyframes toastSlideIn {
            from

        {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }

        }

        @@keyframes fadeOut {
            to

        {
            transform: translateX(120%);
            opacity: 0;
        }

        }

        @@keyframes bounceIcon {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-4px);
        }

        }
    </style>

    <script>
        function showToaster(message, type) {
            const toaster = document.getElementById("custom-toaster");

            // ⚽ Choose icon based on type
            let icon = type === "success" ? "🏆" : "🚫";

            const toast = document.createElement("div");
            toast.className = `toast-msg ${type}`;

            toast.innerHTML = `
                <div class="toast-content">
                    <div class="toast-icon">${icon}</div>
                    <div class="toast-text">${message}</div>
                </div>
                <div class="toast-close">&times;</div>
            `;

            // ❌ Close when clicking X
            toast.querySelector(".toast-close").addEventListener("click", () => {
                toast.remove();
            });

            toaster.appendChild(toast);

            // Auto-remove after 5s
            setTimeout(() => {
                toast.remove();
            }, 5000);
        }

        // ⚡ Read from TempData (server messages)
        document.addEventListener("DOMContentLoaded", function () {
            var success = '@TempData["success-notification"]';
            var error = '@TempData["error-notification"]';

            if (success) showToaster(success, "success");
            if (error) showToaster(error, "error");
        });
    </script>
</body>
</html>
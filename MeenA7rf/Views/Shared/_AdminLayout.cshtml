@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard - MeenA7rf Quiz</title>

    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            min-height: 100vh;
            background: url('https://images.unsplash.com/photo-1508264165352-2585356e95d0?auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover;
            color: #ffd700;
            overflow-x: hidden;
        }

        /* Sidebar */
        .sidebar {
            background-color: rgba(20, 20, 20, 0.9);
            width: 250px;
            flex-shrink: 0;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            gap: 25px;
            border-right: 2px solid #ffd700;
            transition: width 0.3s ease;
        }

            .sidebar.collapsed {
                width: 70px;
                padding: 30px 10px;
                align-items: center;
            }

            .sidebar h2 {
                text-align: center;
                color: #ffd700;
                font-weight: 700;
                font-size: 1.8rem;
                margin-bottom: 30px;
                text-shadow: 0 0 10px #ffd700;
                transition: opacity 0.3s ease, transform 0.3s ease;
            }

            .sidebar.collapsed h2 {
                opacity: 0;
                transform: scale(0);
            }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #fff;
            font-size: 1.1rem;
            cursor: pointer;
            padding: 10px 15px;
            border-radius: 8px;
            transition: background-color 0.3s ease, transform 0.2s ease, gap 0.3s ease;
            text-decoration: none;
            white-space: nowrap;
        }

            .menu-item svg {
                width: 22px;
                height: 22px;
                fill: #ffd700;
                flex-shrink: 0;
            }

            .menu-item:hover {
                background-color: #ffd700;
                color: #121212;
                font-weight: 700;
                transform: translateX(5px);
            }

        .sidebar.collapsed .menu-item {
            justify-content: center;
            gap: 0;
        }

            .sidebar.collapsed .menu-item span {
                display: none;
            }

        /* Toggle button */
        .toggle-btn {
            position: absolute;
            top: 20px;
            left: 260px;
            font-size: 1.5rem;
            background: #ffd700;
            color: #121212;
            border: none;
            border-radius: 6px;
            padding: 6px 10px;
            cursor: pointer;
            transition: left 0.3s ease;
        }

        .sidebar.collapsed + .toggle-btn {
            left: 80px;
        }

        /* Main content */
        .main-content {
            flex: 1;
            padding: 30px 40px;
            overflow-y: auto;
            transition: margin-left 0.3s ease;
            margin-left: 0;
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-thumb {
            background: #ffd700;
            border-radius: 10px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            body

        {
            flex-direction: column;
        }

        .sidebar {
            width: 100%;
            height: auto;
            flex-direction: row;
            justify-content: center;
            padding: 10px 0;
            border-right: none;
            border-bottom: 2px solid #ffd700;
        }

            .sidebar.collapsed {
                height: 60px;
                width: 100%;
            }

        .toggle-btn {
            left: 20px;
            top: 70px;
        }

        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <h2>Admin Panel</h2>
        <a href="/Users" class="menu-item">
            <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg>
            <span>Users</span>
        </a>
        <a href="/Rooms" class="menu-item">
            <svg viewBox="0 0 24 24"><path d="M3 13h2v-2H3v2zm0 6h2v-2H3v2zm0-12h2V5H3v2zm4 12h12v-2H7v2zm0-4h12v-2H7v2zm0-6v2h12V7H7z" /></svg>
            <span>Rooms</span>
        </a>
        <a href="/Questions" class="menu-item">
            <svg viewBox="0 0 24 24"><path d="M12 4a4 4 0 0 0-4 4v1c0 1.1.9 2 2 2h3v2h-2v2h2v2h-3v2h3v1h-3v1h6v-2H14v-1h6v-2h-2v-1h2v-2h-2v-1h2v-2h-2v-1a4 4 0 0 0-4-4z" /></svg>
            <span>Questions</span>
        </a>
        <a href="/Answers" class="menu-item">
            <svg viewBox="0 0 24 24"><path d="M20 6h-3v12h3v-2h-1v-1h1v-1h-1v-1h1V8h-1V7h1V6zM4 18h7v-2H6v-2h5v-2H6v-2h5V6H4v12z" /></svg>
            <span>Answers</span>
        </a>
    </aside>

    <!-- Toggle Button -->
    <button class="toggle-btn" id="toggleBtn">☰</button>

    <!-- Main Content -->
    <div id="main-content" class="main-content">
        @RenderBody()
    </div>

    <script>
        // Sidebar toggle
        const sidebar = document.getElementById("sidebar");
        const toggleBtn = document.getElementById("toggleBtn");

        toggleBtn.addEventListener("click", () => {
            sidebar.classList.toggle("collapsed");
            toggleBtn.classList.toggle("collapsed");
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @RenderSection("Styles", required: false)
    <title>@ViewData["Title"] - MeenA7rf Football Quiz</title>
    <style>
        /* Reset & base */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body, html {
            height: 100%;
            display: flex;
            flex-direction: column;
            background: url('/images/football-bg.jpg') no-repeat center center fixed;
            background-size: cover;
            color: #fff;
        }

        /* Header - Fixed positioning to prevent scrolling overlap */
        header {
            background: rgba(20, 20, 20, 0.7);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            padding: 12px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 50px;
            box-shadow: 0 4px 25px rgba(255, 215, 0, 0.7);
            border: 1px solid rgba(255, 215, 0, 0.6);
            position: fixed;
            top: 20px;
            left: 0;
            right: 0;
            margin: 0 auto;
            max-width: 1100px;
            z-index: 100;
            backdrop-filter: blur(10px);
            /* Transition for smooth show/hide */
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
            will-change: transform, opacity;
        }
            /* حالة الإخفاء (الانزلاق للأعلى مع شفافية صفر) */
            header.hide {
                transform: translateY(-120%);
                opacity: 0;
            }

            header .logo {
                font-size: 1.9rem;
                font-weight: 700;
                color: #FFD700;
                letter-spacing: 1.5px;
                cursor: default;
                user-select: none;
                text-shadow: 0 0 8px #FFD700, 0 0 20px rgba(255,215,0,0.9);
                opacity: 0;
                transform: translateX(-40px);
                animation: slideLogo 1s ease forwards;
            }

        nav ul {
            list-style-type: none;
            display: flex;
            gap: 20px;
            background: rgba(0,0,0, 0.25);
            padding: 10px 20px;
            border-radius: 40px;
            box-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
        }

            nav ul li {
                opacity: 0;
                transform: translateY(-20px);
                animation: fadeUp 0.8s ease forwards;
            }

                nav ul li:nth-child(1) {
                    animation-delay: 0.3s;
                }

                nav ul li:nth-child(2) {
                    animation-delay: 0.5s;
                }

                nav ul li:nth-child(3) {
                    animation-delay: 0.7s;
                }

                nav ul li:nth-child(4) {
                    animation-delay: 0.9s;
                }

                nav ul li a {
                    text-decoration: none;
                    color: #fff;
                    font-weight: 600;
                    padding: 8px 20px;
                    border-radius: 30px;
                    transition: all 0.3s ease;
                    background: rgba(255, 215, 0, 0.15);
                    border: 1px solid transparent;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    box-shadow: 0 0 6px rgba(255, 215, 0, 0.6);
                }

                    nav ul li a:hover {
                        color: #000;
                        background: #FFD700; /* قوي */
                        border: 1px solid #FFD700;
                        box-shadow: 0 0 15px rgba(255, 215, 0, 0.8);
                    }

        /* Animations */
        @@keyframes slideLogo {
            to

        {
            opacity: 1;
            transform: translateX(0);
        }

        }

        @@keyframes fadeUp {
            to

        {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* Main wrapper */
        #main-content {
            flex: 1;
            max-width: 950px;
            margin: 40px auto;
            padding: 160px 20px 20px; /* To clear fixed header */
            width: 100%;
        }

        /* Icons */
        .icon-home::before {
            content: "🏠";
        }

        .icon-rooms::before {
            content: "📂";
        }

        .icon-login::before {
            content: "🔐";
        }

        .icon-register::before {
            content: "📝";
        }

        /* Footer */
        footer {
            background: rgba(20, 20, 20, 0.7);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            padding: 20px 0;
            text-align: center;
            color: #bbb;
            font-size: 0.9rem;
            border-top: 1px solid rgba(255, 215, 0, 0.6);
            margin-top: 50px;
            border-radius: 30px 30px 0 0;
            box-shadow: 0 -4px 20px rgba(255, 215, 0, 0.4);
        }

            footer .footer-content {
                max-width: 1100px;
                margin: auto;
            }

            footer .social-icons {
                margin-top: 10px;
                display: flex;
                justify-content: center;
                gap: 15px;
            }

                footer .social-icons a {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    background: rgba(255, 215, 0, 0.15);
                    border: 1px solid transparent;
                    color: #FFD700;
                    font-size: 1.2rem;
                    transition: all 0.3s ease;
                }

                    footer .social-icons a:hover {
                        background: rgba(255, 215, 0, 0.3);
                        border: 1px solid #FFD700;
                        color: #fff;
                        box-shadow: 0 0 12px rgba(255, 215, 0, 0.7);
                    }
    </style>
</head>
<body>
    <header id="navbar">
        <div class="logo">MeenA7rf Quiz ⚽</div>
        <nav>
            <ul>
                <li><a asp-action="Index" asp-controller="Home" asp-area="Customer" class="icon-home">Home</a></li>

                @if(User.Identity!.IsAuthenticated)
                {
                    <li><a asp-area="Customer" asp-controller="Friend" asp-action="Index">👤 Friends</a></li>
                    <li><a href="#">🧑 Profile</a></li>
                    <li><a asp-action="Signout" asp-controller="Account" asp-area="Identity" class="icon-login">Signout</a></li>
                }
                else
                {
                    <li><a asp-action="Login" asp-controller="Account" asp-area="Identity" class="icon-login">Login</a></li>
                    <li><a asp-action="Register" asp-controller="Account" asp-area="Identity" class="icon-register">Register</a></li>  
                }
            </ul>
        </nav>
    </header>

    <!-- مكان حقن المحتوى -->
    <div id="main-content">
        @RenderBody()
    </div>

    <footer>
        <div class="footer-content">
            <p>© 2025 - MeenA7rf Football Quiz</p>
            <p>Created by Ahmed Khaled Mohamed</p>
            <p>MeenA7rf is a fun football quiz game where friends can challenge each other and test their football knowledge! ⚽🧠</p>
            <div class="social-icons">
                <a href="#" aria-label="Facebook" title="Facebook">📘</a>
                <a href="#" aria-label="Twitter" title="Twitter">🐦</a>
                <a href="#" aria-label="Instagram" title="Instagram">📸</a>
            </div>
        </div>
    </footer>

    


    @RenderSection("Scripts", required: false)

    <script>
        // كود لجعل الـnavbar يختفي عند النزول ويظهر عند الصعود بتأثير انسيابي

        (function() {
            const navbar = document.getElementById('navbar');
            let lastScrollTop = 0;
            let ticking = false;

            window.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

                        if (scrollTop > lastScrollTop && scrollTop > 100) {
                            // Scroll Down - Hide navbar
                            navbar.classList.add('hide');
                        } else {
                            // Scroll Up - Show navbar
                            navbar.classList.remove('hide');
                        }

                        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop; // For Mobile or negative scrolling
                        ticking = false;
                    });
                    ticking = true;
                }
            });
        })();
    </script>

    <!-- ⚽ Custom Football Toaster -->
    <div id="custom-toaster"></div>

    <style>
        /* 🏟️ Container */
        #custom-toaster {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 4000;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* 💫 Toast Message */
        .toast-msg {
            min-width: 310px;
            padding: 15px 18px;
            border-radius: 14px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
            position: relative;
            overflow: hidden;
            animation: toastSlideIn 0.6s ease, fadeOut 0.6s ease 4.5s forwards;
            font-family: "Poppins", sans-serif;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

            /* 🟢 Success */
            .toast-msg.success {
                background: linear-gradient(135deg, #1ecf63, #0b9d47);
                border-left: 6px solid #ffffff80;
            }

            /* 🔴 Error */
            .toast-msg.error {
                background: linear-gradient(135deg, #ff4040, #a30000);
                border-left: 6px solid #ffffff80;
            }

        /* ⚽ Icon Section */
        .toast-content {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-grow: 1;
        }

        .toast-icon {
            font-size: 1.8rem;
            animation: bounceIcon 1.2s infinite ease-in-out;
        }

        /* ❌ Close Button */
        .toast-close {
            cursor: pointer;
            font-weight: bold;
            font-size: 1.2rem;
            opacity: 0.8;
            transition: 0.3s;
        }

            .toast-close:hover {
                opacity: 1;
                transform: scale(1.15);
            }

        /* ✨ Animations */
        @@keyframes toastSlideIn {
            from

        {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }

        }

        @@keyframes fadeOut {
            to

        {
            transform: translateX(120%);
            opacity: 0;
        }

        }

        @@keyframes bounceIcon {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-4px);
        }

        }
    </style>

    <script>
        function showToaster(message, type) {
            const toaster = document.getElementById("custom-toaster");

            // ⚽ Choose icon based on type
            let icon = type === "success" ? "🏆" : "🚫";

            const toast = document.createElement("div");
            toast.className = `toast-msg ${type}`;

            toast.innerHTML = `
                <div class="toast-content">
                    <div class="toast-icon">${icon}</div>
                    <div class="toast-text">${message}</div>
                </div>
                <div class="toast-close">&times;</div>
            `;

            // ❌ Close when clicking X
            toast.querySelector(".toast-close").addEventListener("click", () => {
                toast.remove();
            });

            toaster.appendChild(toast);

            // Auto-remove after 5s
            setTimeout(() => {
                toast.remove();
            }, 5000);
        }

        // ⚡ Read from TempData (server messages)
        document.addEventListener("DOMContentLoaded", function () {
            var success = '@TempData["success-notification"]';
            var error = '@TempData["error-notification"]';

            if (success) showToaster(success, "success");
            if (error) showToaster(error, "error");
        });
    </script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
@using Entities.ViewModels
@model ManageUserVM

<div class="create-container">
    <h2 class="title">Create New User ⚙️</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" name="returnTo" value="@ViewBag.ReturnTo" />

        <div class="form-group">
            <label>First Name</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Last Name</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>User Name</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Roles</label>
            <select asp-for="Roles" asp-items="Model.Roles" multiple class="form-control"></select>
        </div>

        <div class="form-group">
            <label>Confirm Email</label>
            <input asp-for="IsEmailConfirmed" type="checkbox" />
        </div>

        <div class="form-buttons">
            <button type="submit" class="btn-save">💾 Save</button>
            <a asp-action="@ViewBag.ReturnTo" class="btn-cancel">↩ Back</a>
        </div>
    </form>
</div>

<style>
    .create-container {
        max-width: 500px;
        margin: 2rem auto;
        background: #1f1f1f;
        padding: 2rem;
        border-radius: 20px;
        box-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
        color: #fff;
    }

    .title {
        text-align: center;
        color: #FFD700;
        text-shadow: 0 0 10px #FFD700;
        margin-bottom: 1.5rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    label {
        display: block;
        color: #FFD700;
        margin-bottom: 0.3rem;
    }

    .form-control {
        width: 100%;
        padding: 0.6rem;
        border: none;
        border-radius: 8px;
        background: #2a2a2a;
        color: #fff;
        outline: none;
    }

        .form-control:focus {
            box-shadow: 0 0 10px #FFD700;
        }

    .form-buttons {
        display: flex;
        justify-content: space-between;
        margin-top: 1.5rem;
    }

    .btn-save {
        background: #FFD700;
        color: #000;
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        font-weight: bold;
        border: none;
        transition: 0.3s;
    }

        .btn-save:hover {
            background: #fff;
            box-shadow: 0 0 15px #FFD700;
        }

    .btn-cancel {
        background: #444;
        color: #fff;
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-cancel:hover {
            background: #666;
        }
</style>

<main class="main-content">
    <header class="dashboard-header">Admin Dashboard 🏆</header>

    <!-- Stats Cards -->
    <section class="stats-container">
        <div class="stat-card">
            <div class="stat-icon">👤</div>
            <h3>Total Users</h3>
            <div class="stat-number" id="userCount">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🏟️</div>
            <h3>Total Rooms</h3>
            <div class="stat-number" id="roomCount">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">❓</div>
            <h3>Total Questions</h3>
            <div class="stat-number" id="questionCount">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">✅</div>
            <h3>Total Answers</h3>
            <div class="stat-number" id="answerCount">0</div>
        </div>
    </section>

    <!-- Charts Section -->
    <section class="charts-section">
        <h2>Statistics Overview</h2>
        <div class="charts-grid">
            <canvas id="activityChart" width="400" height="300"></canvas>
            <canvas id="distributionChart" width="400" height="300"></canvas>
        </div>
    </section>

    <style>
        /* Ensure Inter font is used */
        * {
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .dashboard-header {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 40px;
            text-align: center;
            color: #ffffff;
            text-shadow: 0 0 15px rgba(74, 144, 226, 0.5);
            animation: fadeInDown 1s ease;
            letter-spacing: -0.5px;
        }

        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.95), rgba(51, 65, 85, 0.9));
            border-radius: 16px;
            padding: 30px 25px;
            text-align: center;
            box-shadow: 0 8px 25px rgba(74, 144, 226, 0.2);
            transition: all 0.3s ease;
            animation: fadeInUp 1s ease;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(74, 144, 226, 0.3);
            backdrop-filter: blur(10px);
        }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(74, 144, 226, 0.1), transparent);
                transition: left 0.6s ease;
            }

            .stat-card:hover::before {
                left: 100%;
            }

            .stat-card:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 12px 35px rgba(74, 144, 226, 0.4);
                border-color: rgba(74, 144, 226, 0.5);
            }

        .stat-icon {
            font-size: 2.2rem;
            margin-bottom: 15px;
            animation: bounce 2s infinite ease-in-out;
            filter: drop-shadow(0 0 8px rgba(74, 144, 226, 0.5));
        }

        .stat-card h3 {
            font-size: 1.1rem;
            color: #e2e8f0;
            margin-bottom: 12px;
            font-weight: 500;
            letter-spacing: 0.3px;
        }

        .stat-number {
            font-size: 2.8rem;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 0 12px rgba(74, 144, 226, 0.3);
            letter-spacing: -0.5px;
        }

        .charts-section {
            margin-top: 60px;
            text-align: center;
            background: rgba(30, 41, 59, 0.5);
            border-radius: 20px;
            padding: 40px;
            backdrop-filter: blur(10px);
        }

            .charts-section h2 {
                margin-bottom: 30px;
                font-size: 1.8rem;
                color: #ffffff;
                text-shadow: 0 0 10px rgba(74, 144, 226, 0.3);
                animation: fadeIn 1s ease;
                font-weight: 600;
            }

        .charts-grid {
            display: flex;
            justify-content: center;
            gap: 40px;
            flex-wrap: wrap;
        }

        canvas {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.8), rgba(51, 65, 85, 0.7));
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 8px 25px rgba(74, 144, 226, 0.2);
            border: 1px solid rgba(74, 144, 226, 0.3);
            backdrop-filter: blur(10px);
        }

        /* Animations */
        @@keyframes fadeInDown {
            from

        {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
        }

        to {
            opacity: 1;
        }

        }

        @@keyframes bounce {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }

        }

        /* Responsive */
        @@media (max-width: 768px) {
            .dashboard-header

        {
            font-size: 2rem;
        }

        .stats-container {
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
        }

        .stat-card {
            padding: 20px 15px;
        }

        .stat-number {
            font-size: 2.2rem;
        }

        .charts-grid {
            gap: 20px;
            flex-direction: column;
            align-items: center;
        }

        canvas {
            width: 300px !important;
            height: 250px !important;
            padding: 15px;
        }

        .charts-section {
            padding: 20px;
            margin-top: 40px;
        }

        }
    </style>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Animate numbers
        function animateValue(id, start, end, duration) {
            let range = end - start;
            let current = start;
            let increment = end > start ? 1 : -1;
            let stepTime = Math.abs(Math.floor(duration / range));
            let obj = document.getElementById(id);
            let timer = setInterval(function () {
                current += increment;
                obj.textContent = current;
                if (current == end) clearInterval(timer);
            }, stepTime);
        }

        animateValue("userCount", 0, 45, 1500);
        animateValue("roomCount", 0, 12, 1500);
        animateValue("questionCount", 0, 120, 1500);
        animateValue("answerCount", 0, 350, 1500);

        // Bar Chart (Fixed Size)
        const ctx1 = document.getElementById('activityChart');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: ['Users', 'Rooms', 'Questions', 'Answers'],
                datasets: [{
                    label: 'Activity Count',
                    data: [45, 12, 120, 350],
                    backgroundColor: ['#4A90E2', '#357ABD', '#2C5AA0', '#1E3A8A'],
                    borderRadius: 8,
                    borderSkipped: false,
                }]
            },
            options: {
                responsive: false,  // Disable auto resize for fixed size
                plugins: {
                    legend: {
                        labels: {
                            color: '#e2e8f0',
                            font: { size: 14, family: 'Inter' }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: '#e2e8f0' },
                        grid: { color: 'rgba(74, 144, 226, 0.2)' }
                    },
                    y: {
                        ticks: { color: '#e2e8f0' },
                        grid: { color: 'rgba(74, 144, 226, 0.2)' }
                    }
                },
                backgroundColor: 'transparent'
            }
        });

        // Pie Chart (Fixed Size)
        const ctx2 = document.getElementById('distributionChart');
        new Chart(ctx2, {
            type: 'pie',
            data: {
                labels: ['Users', 'Rooms', 'Questions', 'Answers'],
                datasets: [{
                    data: [45, 12, 120, 350],
                    backgroundColor: ['#4A90E2', '#357ABD', '#2C5AA0', '#1E3A8A'],
                    borderWidth: 2,
                    borderColor: 'rgba(30, 41, 59, 0.8)'
                }]
            },
            options: {
                responsive: false,  // Disable auto resize for fixed size
                plugins: {
                    legend: {
                        labels: {
                            color: '#e2e8f0',
                            font: { size: 14, family: 'Inter' }
                        }
                    }
                }
            }
        });
    </script>
</main>
@using Entities.ViewModels
@model ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
}

<div class="reset-container">
    <div class="reset-card">
        <h2 class="reset-title">Reset Password 🔒</h2>
        <p class="reset-subtitle">Enter the OTP sent to your email and create a new password.</p>

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="UserId" />

            <div class="form-group">
                <label asp-for="OTP"></label>
                <input asp-for="OTP" class="form-control" placeholder="Enter OTP" />
                <span asp-validation-for="OTP" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="New Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm New Password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-reset">Reset Password</button>

            <p class="reset-footer">
                Remembered your password?
                <a asp-action="Login" asp-controller="Account" asp-area="Identity" style="color:#ffdf00;">Login here</a>
            </p>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .reset-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
            background: url('/images/stadium-bg.jpg') no-repeat center center/cover;
        }

        .reset-card {
            background: rgba(0,0,0,0.85);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(255, 223, 0, 0.7);
            width: 400px;
            text-align: center;
        }

        .reset-title {
            color: #ffdf00;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .reset-subtitle {
            color: #ccc;
            margin-bottom: 20px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 15px;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: none;
            outline: none;
        }

        .btn-reset {
            width: 100%;
            padding: 12px;
            background-color: #ffdf00;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-reset:hover {
                background-color: #ffd600;
                transform: scale(1.05);
            }

        .reset-footer {
            margin-top: 15px;
            color: #ccc;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@using Entities.ViewModels
@model ForgotPasswordVM

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">Forgot Password 🔑</h2>
        <p class="auth-subtitle">Enter your email or username and we’ll send you a reset link.</p>

        <form asp-action="ForgotPassword" method="post" class="auth-form">
            <div class="form-group">
                <label asp-for="UserNameOrEmail"></label>
                <input asp-for="UserNameOrEmail" class="form-control" placeholder="Enter your email or username" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth">Send Reset Link</button>
        </form>

        <div class="auth-links">
            <p>
                <a asp-action="Login" asp-controller="Account" asp-area="Identity">Back to Login</a>
            </p>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .auth-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
            background: url('/images/stadium-bg.jpg') no-repeat center center/cover;
        }

        .auth-card {
            background: rgba(0,0,0,0.85);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(255, 223, 0, 0.7);
            width: 400px;
            text-align: center;
        }

        .auth-title {
            color: #ffdf00;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .auth-subtitle {
            color: #ccc;
            margin-bottom: 20px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 15px;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: none;
            outline: none;
        }

        .btn-auth {
            width: 100%;
            padding: 12px;
            background-color: #ffdf00;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-auth:hover {
                background-color: #ffd600;
                transform: scale(1.05);
            }

        .auth-links {
            margin-top: 15px;
            color: #ccc;
        }

            .auth-links a {
                color: #ffdf00;
                font-weight: bold;
                text-decoration: none;
            }

                .auth-links a:hover {
                    text-decoration: underline;
                }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

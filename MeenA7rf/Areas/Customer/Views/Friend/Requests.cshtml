@using Entities.Models
@model List<Friendship>

<div class="mini-requests">
    <h3 class="mini-requests-title">Pending Requests 💌</h3>

    @if (Model == null || !Model.Any())
    {
        <p class="no-mini-requests">No new requests for now ⚽</p>
    }
    else
    {
        <div class="mini-requests-list">
            @foreach (var req in Model)
            {
                <div class="mini-request-item">
                    <span class="mini-request-name">@req.Player.UserName</span>
                    <div class="mini-request-actions">
                        <form asp-action="AcceptRequest" method="post">
                            <input type="hidden" name="requestId" value="@req.Id" />
                            <button type="submit" class="btn-mini accept">✅</button>
                        </form>
                        <form asp-action="DeleteRequest" method="post">
                            <input type="hidden" name="requestId" value="@req.Id" />
                            <button type="submit" class="btn-mini delete">❌</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    :root {
        --gold: #ffd700;
        --red: #e74c3c;
        --light-text: #fff;
        --muted-text: rgba(255, 255, 255, 0.8);
    }

    .mini-requests {
        padding: 20px;
        border: 1px solid rgba(255, 215, 0, 0.3);
        border-radius: 15px;
        backdrop-filter: blur(6px);
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 0 10px rgba(255, 215, 0, 0.1);
        max-width: 600px;
        margin: 30px auto;
        text-align: center;
    }

    .mini-requests-title {
        color: var(--gold);
        font-size: 1.4rem;
        margin-bottom: 15px;
        font-weight: 600;
    }

    .no-mini-requests {
        color: var(--muted-text);
        font-size: 1rem;
        margin-top: 10px;
    }

    .mini-requests-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 10px;
    }

    .mini-request-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 10px 15px;
        border: 1px solid rgba(255, 215, 0, 0.2);
        transition: 0.25s ease;
    }

        .mini-request-item:hover {
            transform: translateY(-3px);
            border-color: var(--gold);
            box-shadow: 0 2px 10px rgba(255, 215, 0, 0.2);
        }

    .mini-request-name {
        color: var(--light-text);
        font-weight: 600;
        font-size: 1rem;
        text-align: left;
    }

    .mini-request-actions {
        display: flex;
        gap: 8px;
    }

    .btn-mini {
        border: none;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 1rem;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .btn-mini.accept {
            background: var(--gold);
            color: #000;
        }

            .btn-mini.accept:hover {
                transform: scale(1.1);
                box-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
            }

        .btn-mini.delete {
            background: var(--red);
            color: #fff;
        }

            .btn-mini.delete:hover {
                transform: scale(1.1);
                box-shadow: 0 0 10px rgba(231, 76, 60, 0.5);
            }

    @@media (max-width: 600px) {
        .mini-request-item

    {
        flex-direction: column;
        gap: 8px;
        text-align: center;
    }

    .mini-request-actions {
        justify-content: center;
    }

    }
</style>
